RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Where form submissions go (comma-separated for several inboxes)
CONTACT_TO=management@devmatesolutions.com
# After verifying devmatesolutions.com in Resend, switch to e.g. Sixty by DevMate <sixty@devmatesolutions.com>
# (this also turns on the automatic "thanks, we got your message" email to the lead)
RESEND_FROM=Sixty by DevMate <onboarding@resend.dev>
# Retell AI: live voice demo (the floating "Talk to Freya" ball)
RETELL_API_KEY=key_xxxxxxxxxxxxxxxxxxxx
RETELL_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: pin an agent version; leave unset to use Retell's default
# RETELL_AGENT_VERSION=5
# Live WhatsApp demo (chat agent with the update_crm tool)
RETELL_CHAT_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxxxxxx
# Gemini (live WhatsApp demo + voice orb)
GEMINI_API_KEY=xxxxxxxx
GEMINI_CHAT_MODEL=gemini-3.8-flash
# Leads CRM (n8n webhook -> Google Sheet)
CRM_WEBHOOK_URL=https://your-n8n/webhook/sixty-leads
CRM_WEBHOOK_SECRET=xxxxxxxx
CRM_SHEET_URL=https://script.google.com/macros/s/xxxx/exec

# Database (Supabase) - used by /tracker to persist all tasks & client progress
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
